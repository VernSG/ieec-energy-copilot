      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InjectContext_AICopilot_di" bpmnElement="Task_InjectContext_AICopilot">
        <dc:Bounds x="1425" y="200" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeReview_di" bpmnElement="Gateway_MergeReview" isMarkerVisible="true">
        <dc:Bounds x="1575" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewRecommendation_di" bpmnElement="Task_ReviewRecommendation">
        <dc:Bounds x="1665" y="200" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReviewDecision_di" bpmnElement="Gateway_ReviewDecision" isMarkerVisible="true">
        <dc:Bounds x="1815" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1814" y="176" width="53" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
