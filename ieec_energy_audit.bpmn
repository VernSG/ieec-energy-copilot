      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CalcIKE_And_EnB_di" bpmnElement="Task_CalcIKE_And_EnB">
        <dc:Bounds x="875" y="200" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DetectWaste_Anomalies_di" bpmnElement="Task_DetectWaste_Anomalies">
