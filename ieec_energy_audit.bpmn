          <dc:Bounds x="2211" y="265" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_MergeIngest_di" bpmnElement="Flow_Start_To_MergeIngest">
        <di:waypoint x="198" y="240" />
        <di:waypoint x="245" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Ingest_di" bpmnElement="Flow_To_Ingest">
        <di:waypoint x="295" y="240" />
        <di:waypoint x="335" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Validate_di" bpmnElement="Flow_To_Validate">
        <di:waypoint x="445" y="240" />
        <di:waypoint x="485" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_GatewayDataValid_di" bpmnElement="Flow_To_GatewayDataValid">
        <di:waypoint x="595" y="240" />
        <di:waypoint x="635" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DataValid_Yes_di" bpmnElement="Flow_DataValid_Yes">
        <di:waypoint x="685" y="240" />
        <di:waypoint x="725" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="699" y="222" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DataValid_No_di" bpmnElement="Flow_DataValid_No">
        <di:waypoint x="660" y="215" />
        <di:waypoint x="660" y="110" />
        <di:waypoint x="595" y="110" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="667" y="153" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_From_Koreksi_di" bpmnElement="Flow_From_Koreksi">
        <di:waypoint x="485" y="110" />
        <di:waypoint x="270" y="110" />
        <di:waypoint x="270" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_CalcIKE_di" bpmnElement="Flow_To_CalcIKE">
        <di:waypoint x="835" y="240" />
        <di:waypoint x="875" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_DetectWaste_di" bpmnElement="Flow_To_DetectWaste">
        <di:waypoint x="985" y="240" />
        <di:waypoint x="1025" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_CalcFinancial_di" bpmnElement="Flow_To_CalcFinancial">
        <di:waypoint x="1135" y="240" />
        <di:waypoint x="1175" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_GatewayWaste_di" bpmnElement="Flow_To_GatewayWaste">
        <di:waypoint x="1285" y="240" />
        <di:waypoint x="1325" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Waste_Yes_di" bpmnElement="Flow_Waste_Yes">
        <di:waypoint x="1375" y="240" />
        <di:waypoint x="1425" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1394" y="222" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
