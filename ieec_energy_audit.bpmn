        <dc:Bounds x="1665" y="70" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1822" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1807" y="415" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fork_Execution_di" bpmnElement="Gateway_Fork_Execution">
        <dc:Bounds x="1905" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
