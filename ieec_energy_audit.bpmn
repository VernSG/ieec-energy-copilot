<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_IEEC" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="Process_IEEC_EnergyAudit" name="Industrial Energy Efficiency Copilot (IEEC) - Process Audit &#38; Mitigasi" isExecutable="true">
    <bpmn:startEvent id="StartEvent_DataReceived" name="Data Masuk&#10;(CSV / IoT)">
      <bpmn:outgoing>Flow_Start_To_MergeIngest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_MergeIngest">
      <bpmn:incoming>Flow_Start_To_MergeIngest</bpmn:incoming>
      <bpmn:incoming>Flow_From_Koreksi</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Ingest</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_IngestData" name="Ingesti &#38; Parsing&#10;Data Energi">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ingest-energy-data" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Validate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ValidateDataQuality" name="Validasi Integritas&#10;Data Konsumsi">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-energy-data" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_To_GatewayDataValid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DataValid" name="Data Valid?" default="Flow_DataValid_Yes">
      <bpmn:incoming>Flow_To_GatewayDataValid</bpmn:incoming>
      <bpmn:outgoing>Flow_DataValid_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DataValid_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_KoreksiData" name="Koreksi Format /&#10;Input Ulang Data">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_KoreksiData" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DataValid_No</bpmn:incoming>
      <bpmn:outgoing>Flow_From_Koreksi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CalcESDM_Compliance" name="Kalkulasi PP 33/2023&#10;(TOE &#38; SBM)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="calculate-esdm-compliance" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DataValid_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_To_CalcIKE</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CalcIKE_And_EnB" name="Hitung IKE &#38;&#10;Baseline EnB">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="calculate-ike-baseline" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_CalcIKE</bpmn:incoming>
      <bpmn:outgoing>Flow_To_DetectWaste</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DetectWaste_Anomalies" name="Deteksi Anomali &#38;&#10;Pemborosan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="detect-waste-anomalies" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_DetectWaste</bpmn:incoming>
      <bpmn:outgoing>Flow_To_CalcFinancial</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CalculateFinancialImpact" name="Kalkulasi Biaya PLN&#10;&#38; Reduksi Emisi">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="calculate-financial-carbon" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_CalcFinancial</bpmn:incoming>
      <bpmn:outgoing>Flow_To_GatewayWaste</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CheckWaste" name="Terdeteksi&#10;Pemborosan?" default="Flow_Waste_No">
      <bpmn:incoming>Flow_To_GatewayWaste</bpmn:incoming>
      <bpmn:outgoing>Flow_Waste_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Waste_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GenerateNormalReport" name="Arsip Laporan&#10;Efisiensi Rutin">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-normal-report" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Waste_No</bpmn:incoming>
      <bpmn:outgoing>Flow_To_EndNormal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Normal" name="Fasilitas Beroperasi&#10;Efisien">
      <bpmn:incoming>Flow_To_EndNormal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_InjectContext_AICopilot" name="AI Copilot: Diagnosis&#10;&#38; 3 Rekomendasi">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-ai-recommendations" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Waste_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Copilot_To_MergeReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeReview">
      <bpmn:incoming>Flow_Copilot_To_MergeReview</bpmn:incoming>
      <bpmn:incoming>Flow_From_ChatCopilot</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviewRecommendation" name="Review Rekomendasi&#10;(Energy Manager)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ReviewRecommendation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_To_GatewayReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Keputusan&#10;Review?" default="Flow_Review_Approved">
      <bpmn:incoming>Flow_To_GatewayReview</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Review_Simulate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Review_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ChatInteractiveCopilot" name="Tanya Copilot /&#10;Simulasi Skenario">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ChatInteractiveCopilot" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Review_Simulate</bpmn:incoming>
      <bpmn:outgoing>Flow_From_ChatCopilot</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Rejected" name="Rekomendasi&#10;Ditolak">
      <bpmn:incoming>Flow_Review_Reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_Fork_Execution">
      <bpmn:incoming>Flow_Review_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_WorkOrder</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Report</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_DispatchWorkOrder" name="Disposisi Work Order&#10;Mitigasi Utilitas">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dispatch-energy-workorder" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_WorkOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_WorkOrder</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ExportESDMReport" name="Ekspor Laporan Audit&#10;Standar ESDM">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="export-esdm-audit-report" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_Report</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Report</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Join_Execution">
      <bpmn:incoming>Flow_Join_WorkOrder</bpmn:incoming>
      <bpmn:incoming>Flow_Join_Report</bpmn:incoming>
      <bpmn:outgoing>Flow_To_EndAudit</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_Completed" name="Audit Selesai &#38;&#10;Mitigasi Terjadwal">
      <bpmn:incoming>Flow_To_EndAudit</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_MergeIngest" sourceRef="StartEvent_DataReceived" targetRef="Gateway_MergeIngest" />
    <bpmn:sequenceFlow id="Flow_To_Ingest" sourceRef="Gateway_MergeIngest" targetRef="Task_IngestData" />
    <bpmn:sequenceFlow id="Flow_To_Validate" sourceRef="Task_IngestData" targetRef="Task_ValidateDataQuality" />
    <bpmn:sequenceFlow id="Flow_To_GatewayDataValid" sourceRef="Task_ValidateDataQuality" targetRef="Gateway_DataValid" />
    <bpmn:sequenceFlow id="Flow_DataValid_Yes" name="Ya" sourceRef="Gateway_DataValid" targetRef="Task_CalcESDM_Compliance" />
    <bpmn:sequenceFlow id="Flow_DataValid_No" name="Tidak" sourceRef="Gateway_DataValid" targetRef="Task_KoreksiData">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isDataValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_From_Koreksi" sourceRef="Task_KoreksiData" targetRef="Gateway_MergeIngest" />
    <bpmn:sequenceFlow id="Flow_To_CalcIKE" sourceRef="Task_CalcESDM_Compliance" targetRef="Task_CalcIKE_And_EnB" />
    <bpmn:sequenceFlow id="Flow_To_DetectWaste" sourceRef="Task_CalcIKE_And_EnB" targetRef="Task_DetectWaste_Anomalies" />
    <bpmn:sequenceFlow id="Flow_To_CalcFinancial" sourceRef="Task_DetectWaste_Anomalies" targetRef="Task_CalculateFinancialImpact" />
    <bpmn:sequenceFlow id="Flow_To_GatewayWaste" sourceRef="Task_CalculateFinancialImpact" targetRef="Gateway_CheckWaste" />
    <bpmn:sequenceFlow id="Flow_Waste_Yes" name="Ya" sourceRef="Gateway_CheckWaste" targetRef="Task_InjectContext_AICopilot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=terdapatPemborosan = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Waste_No" name="Tidak (Normal)" sourceRef="Gateway_CheckWaste" targetRef="Task_GenerateNormalReport" />
    <bpmn:sequenceFlow id="Flow_To_EndNormal" sourceRef="Task_GenerateNormalReport" targetRef="EndEvent_Normal" />
    <bpmn:sequenceFlow id="Flow_Copilot_To_MergeReview" sourceRef="Task_InjectContext_AICopilot" targetRef="Gateway_MergeReview" />
    <bpmn:sequenceFlow id="Flow_To_Review" sourceRef="Gateway_MergeReview" targetRef="Task_ReviewRecommendation" />
    <bpmn:sequenceFlow id="Flow_To_GatewayReview" sourceRef="Task_ReviewRecommendation" targetRef="Gateway_ReviewDecision" />
    <bpmn:sequenceFlow id="Flow_Review_Approved" name="Disetujui" sourceRef="Gateway_ReviewDecision" targetRef="Gateway_Fork_Execution" />
    <bpmn:sequenceFlow id="Flow_Review_Simulate" name="Simulasi" sourceRef="Gateway_ReviewDecision" targetRef="Task_ChatInteractiveCopilot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=keputusanReview = "SIMULATE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_From_ChatCopilot" sourceRef="Task_ChatInteractiveCopilot" targetRef="Gateway_MergeReview" />
    <bpmn:sequenceFlow id="Flow_Review_Reject" name="Ditolak" sourceRef="Gateway_ReviewDecision" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=keputusanReview = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Fork_WorkOrder" sourceRef="Gateway_Fork_Execution" targetRef="Task_DispatchWorkOrder" />
    <bpmn:sequenceFlow id="Flow_Fork_Report" sourceRef="Gateway_Fork_Execution" targetRef="Task_ExportESDMReport" />
    <bpmn:sequenceFlow id="Flow_Join_WorkOrder" sourceRef="Task_DispatchWorkOrder" targetRef="Gateway_Join_Execution" />
    <bpmn:sequenceFlow id="Flow_Join_Report" sourceRef="Task_ExportESDMReport" targetRef="Gateway_Join_Execution" />
    <bpmn:sequenceFlow id="Flow_To_EndAudit" sourceRef="Gateway_Join_Execution" targetRef="EndEvent_Completed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_IEEC_EnergyAudit">
      <bpmndi:BPMNShape id="StartEvent_DataReceived_di" bpmnElement="StartEvent_DataReceived">
        <dc:Bounds x="162" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
